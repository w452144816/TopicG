# 复制为 .env 后填写

# ---- MiniMax（Coding Plan，Anthropic 兼容接口）----
MINIMAX_API_KEY=
# 国内：https://api.minimaxi.com/anthropic   海外：https://api.minimax.io/anthropic
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.5
# 若该模型不支持图片输入，改为 false，图片提取请切换 Claude
MINIMAX_SUPPORTS_VISION=true

# ---- Claude 官方 ----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-5

# 默认引擎：minimax / claude
DEFAULT_PROVIDER=minimax

# ---- 可选 HTTP 代理 ----
# 填了地址后页面「引擎高级设置」里会出现勾选项；PROXY_ENABLED=true 表示默认勾上
PROXY_URL=http://192.168.80.222:3128
PROXY_ENABLED=false
